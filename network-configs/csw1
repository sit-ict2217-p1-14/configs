enable
configure terminal



hostname CSW1

! === Remote Management ===
ip domain name net.mgmt.office1.shiba.sitict.net
ip name-server 172.18.4.32

crypto key generate rsa

vlan 99
  name OOB
exit

vrf definition Mgmt-vrf
exit

interface g0/0
  ip address 10.0.0.8 255.255.255.240
  vrf forwarding Mgmt-vrf
  no shutdown
exit



! === AAA ===

aaa new-model

username user privilege 15 secret 0 Student@s1t

line vty 0 98
 logging synchronous
 transport input ssh
 exec-timeout 20 0
 login authentication default
exit

tacacs server TACVM
 address ipv4 10.0.0.3
 key Student@s1t
 timeout 2
exit

aaa authorization console

aaa group server tacacs+ TACGRP
 server name TACVM
 ip vrf forwarding Mgmt-vrf
 ip tacacs source-interface g0/0
exit
aaa authentication login default group TACGRP local
aaa authorization exec default group TACGRP local
aaa authorization commands 15 default group TACGRP local
aaa accounting exec default start-stop group TACGRP
aaa accounting commands 15 default stop-only group TACGRP


! === Inter-VLAN Routing ===
ip routing


vlan 10
  name Staff
vlan 20
  name ATM
vlan 30
  name HR
vlan 40
  name IT
vlan 45
  name Jump
vlan 50
  name SRV_DB
vlan 55
  name SRV_File
vlan 60
  name DMZ
vlan 99
  name OOB
vlan 100
  name Core_Sync
vlan 500
  name Park
vlan 999
  name Native

interface vlan 10
  ip address 172.16.1.2 255.255.255.224
  standby version 2
  standby 10 ip 172.16.1.1
  standby 10 priority 100
  no shutdown

interface vlan 20
  ip address 172.16.1.34 255.255.255.248
  standby version 2
  standby 20 ip 172.16.1.33
  standby 20 priority 100
  no shutdown

interface vlan 30
  ip address 172.16.1.42 255.255.255.248
  standby version 2
  standby 30 ip 172.16.1.41
  standby 30 priority 100
  no shutdown

interface vlan 40
  ip address 172.16.1.50 255.255.255.248
  standby version 2
  standby 40 ip 172.16.1.49
  standby 40 priority 100
  no shutdown

interface vlan 45
  ip address 172.16.1.58 255.255.255.248
  standby version 2
  standby 45 ip 172.16.1.57
  standby 45 priority 100
  no shutdown
exit

end
