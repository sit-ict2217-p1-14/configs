enable
configure terminal

<% DeviceName=DSSW -%>
<%+ ./partials/common.esh.part -%>
<% CommonConfigAll $DeviceName -%>

interface g1/0/1
<% AccessportStanza "$VLAN_Jump_ID" -%>

interface g1/0/2
<% AccessportStanza "$VLAN_DMZ_ID" -%>

interface range g1/0/3-23
<% ShutportStanza -%>

interface g1/0/24
<% TrunkportStanza "$VLAN_Jump_ID,$VLAN_DMZ_ID" -%>

end