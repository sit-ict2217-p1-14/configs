enable
config terminal

<% DeviceName=FW1 -%>
<%+ ./partials/common.esh.part -%>
<% CommonConfigAll $DeviceName -%>

no interface vlan 1

<%
ASARouteportStanza () {
  name="$1"
  securityLevel="$2"
  ipAddress="$3"
  subnetMask="$4"
  cat <<EOF
 no switchport
 nameif $name
 security-level $securityLevel
 ip address $ipAddress $subnetMask
 no shutdown
EOF
}
-%>

interface e1/1
<% ASARouteportStanza 'inside1' 100 "$VLAN_DSW1_FW1_DEFAULT_GATEWAY" "$VLAN_DSW1_FW1_SUBNET_MASK" %>

interface e1/2
<% ASARouteportStanza 'inside2' 100 "$VLAN_DSW2_FW1_DEFAULT_GATEWAY" "$VLAN_DSW2_FW1_SUBNET_MASK" %>

interface e1/3
 switchport
 switchport mode trunk
 switchport trunk allowed vlan $VLAN_Jump_ID,$VLAN_DMZ_ID

interface e1/5
 shutdown
interface e1/6
 shutdown

interface e1/7
<% ASARouteportStanza 'outside1' 0 "$VLAN_R1_FW1_FIRST_HOST" "$VLAN_R1_FW1_SUBNET_MASK" %>

interface e1/8
<% ASARouteportStanza 'outside2' 0 "$VLAN_R2_FW1_FIRST_HOST" "$VLAN_R2_FW1_SUBNET_MASK" %>

! === OSPF ===
router ospf 1
 router-id <%= $FW1_OOB_IP_ADDRESS %>
 network <%= $VLAN_R1_FW1_SUBNET_ADDRESS %> <%= $VLAN_R1_FW1_SUBNET_MASK %> area 0
 network <%= $VLAN_R2_FW1_SUBNET_ADDRESS %> <%= $VLAN_R2_FW1_SUBNET_MASK %> area 0
 network <%= $VLAN_DSW1_FW1_SUBNET_ADDRESS %> <%= $VLAN_DSW1_FW1_SUBNET_MASK %> area 0
 network <%= $VLAN_DSW2_FW1_SUBNET_ADDRESS %> <%= $VLAN_DSW2_FW1_SUBNET_MASK %> area 0
 redistribute connected subnets
 log-adj-changes
exit


policy-map global_policy
 class inspection_default
  inspect icmp

! === Hole-punching ===
object network DMZ-WEB
 host <%= $WebServer_ISP1_IP_ADDRESS %>

object network DMZ-DNS
 host <%= $AuthoritativeDNSServer_ISP1_IP_ADDRESS %>

object network JUMP-JUMPHOST
 host <%= $Jumphost_ISP1_IP_ADDRESS %>

access-group OUTSIDE-IN in interface outside
access-list OUTSIDE-IN extended permit tcp any object DMZ-WEB eq www
access-list OUTSIDE-IN extended permit tcp any object DMZ-WEB eq https
access-list OUTSIDE-IN extended permit icmp any object DMZ-WEB

access-list OUTSIDE-IN extended permit tcp any object DMZ-DNS eq domain
access-list OUTSIDE-IN extended permit icmp any object DMZ-DNS

access-list OUTSIDE-IN extended permit tcp any object JUMP-JUMPHOST eq ssh
access-list OUTSIDE-IN extended permit icmp any object JUMP-JUMPHOST

end