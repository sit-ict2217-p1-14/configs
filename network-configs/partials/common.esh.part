<%

Internal_CommonConfigAll_CISCO_IOS () {
  cat <<EOF
hostname $networkDeviceName

! === Remote Management ===
ip domain name $DOMAIN_SUFFIX_NET_MGMT
ip name-server $CachingDNSServer_IP_ADDRESS

crypto key generate rsa

vrf definition $OOB_VRF_NAME
 address-family ipv4
 exit-address-family
exit

interface $oobInterface
 vrf forwarding $OOB_VRF_NAME
 ip address $oobIPAddress $VLAN_OOB_SUBNET_MASK
 no shutdown
exit



! === AAA ===

aaa new-model

username $ADMIN_USERNAME privilege 15 secret 0 $ADMIN_PASSWORD

line vty 0 $vtyMax
 logging synchronous
 transport input ssh
 exec-timeout 20 0
 login authentication default
exit

tacacs server TACVM
 address ipv4 $AAA_IP_ADDRESS
 key $SECRET_TACACS
 timeout 2
exit

aaa group server tacacs+ TACGRP
 server name TACVM
 ip vrf forwarding $OOB_VRF_NAME
 ip tacacs source-interface $oobInterface
exit

aaa authentication login default group TACGRP local
aaa accounting exec default start-stop group TACGRP
aaa accounting commands 15 default stop-only group TACGRP
aaa authorization exec default group TACGRP local
aaa authorization commands 15 default group TACGRP local
aaa authorization console


EOF
}

Internal_CommonConfigAll_CISCO_ASA () {
  cat <<EOF
; === Remote Management ===
interface $oobInterface
 management-only
 nameif management
 security-level 100
 ip address $oobIPAddress $VLAN_OOB_SUBNET_MASK
exit

crypto key generate rsa modulus 2048
yes

ssh 0.0.0.0 0.0.0.0 management

ssh timeout 20
console timeout 20

; === AAA ===
; Test command: test aaa-server authentication TACGRP host $AAA_IP_ADDRESS username $SECRET_TACACS_ADMIN_USERNAME
aaa-server TACGRP protocol tacacs+
aaa-server TACGRP (management) host $AAA_IP_ADDRESS
 key $SECRET_TACACS
 timeout 2
exit

aaa authentication ssh console TACGRP LOCAL
aaa authentication serial console TACGRP LOCAL
aaa authentication enable console TACGRP LOCAL

aaa accounting ssh console TACGRP
aaa accounting serial console TACGRP
aaa accounting command privilege 15 TACGRP

aaa authorization exec authentication-server auto-enable
EOF
}


Internal_CommonConfigAll_PALOALTO_PANOS () {
  cat <<EOF
! === Remote Management ===
edit deviceconfig system
 set hostname $networkDeviceName
 set ip-address $oobIPAddress
 set netmask $VLAN_OOB_SUBNET_MASK
 set domain $DOMAIN_SUFFIX_NET_MGMT
 set domain-lookup-url $CachingDNSServer_IP_ADDRESS
top

; === AAA ===
; Test command: test authentication authentication-profile TAC-AUTH username $SECRET_TACACS_ADMIN_USERNAME password
edit shared server-profile tacplus TACVM
 set timeout 2
 set protocol PAP
 set server TACVM address $AAA_IP_ADDRESS secret $SECRET_TACACS port 49
 set admin-use-only yes
top

edit shared authentication-profile TAC-AUTH
 set method tacplus server-profile TACVM
 set allow-list all
top

edit deviceconfig system
 set authentication-profile TAC-AUTH
top
EOF
}

CommonConfigAll () {
  networkDeviceName="$1"
  OOB_VRF_NAME='Mgmt-vrf'
  eval "$(cat <<EOF
    syntax="\${${networkDeviceName}_SYNTAX}"
    vtyMax="\${${networkDeviceName}_VTY_COUNT}"
    oobIPAddress="\${${networkDeviceName}_OOB_IP_ADDRESS}"
    oobInterface="\${${networkDeviceName}_OOB_INTERFACE}"
EOF
  )"

  case "$syntax" in
    CISCO-IOS)
      Internal_CommonConfigAll_CISCO_IOS ;;
    CISCO-ASA)
      Internal_CommonConfigAll_CISCO_ASA ;;
    PA-PANOS)
      Internal_CommonConfigAll_PALOALTO_PANOS ;;
    *)
      echo "Error: '$syntax' is an unrecognised syntax type." >&2
  esac
}

CommonConfigR () {
  deviceName="$1"

  # Some janky hardcoding
  if [ "$deviceName" = "R1" ]; then
    routerIndex=1
  else
    routerIndex=2
  fi

  eval "$(cat <<EOF
    oobIPAddress="\$${deviceName}_OOB_IP_ADDRESS"
    ispRouterIP="\$ISP${routerIndex}_ROUTER_IP"
    ispSubnetMask="\$ISP${routerIndex}_SUBNET_MASK"
    rxFW1VlanIPAddress="\$VLAN_R${routerIndex}_FW1_DEFAULT_GATEWAY"
    rxFW1VlanSubnetMask="\$VLAN_R${routerIndex}_FW1_SUBNET_MASK"
    rxFW1VlanSubnetAddress="\$VLAN_R${routerIndex}_FW1_SUBNET_ADDRESS"
    rxFW1VlanNetworkWildcard="\$VLAN_R${routerIndex}_FW1_NETWORK_WILDCARD"
EOF
  )"

  cat <<EOF
! === LAN-side: to FW1 ===
interface g0/0/0
 ip address $rxFW1VlanIPAddress $rxFW1VlanSubnetMask
 ip nat inside
 no shutdown

! === WAN-side: to ISP1 ===
interface g0/1/1
 ip address $ispRouterIP $ispSubnetMask
 ip nat outside
 no shutdown
exit

! === OSPF ===
router ospf 1
 router-id $oobIPAddress
 passive-interface default
 no passive-interface g0/0/0
 network $rxFW1VlanSubnetAddress $rxFW1VlanNetworkWildcard area 0
 default-information originate
exit

ip nat pool snat-pool 203.149.211.9 203.149.211.9 prefix-length 29

ip access-list standard snat-acl
 10 permit host $ispRouterIP
 20 permit $PRIVATE_NETWORK_SUBNET_ADDRESS $PRIVATE_NETWORK_NETWORK_WILDCARD

ip nat inside source list snat-acl pool snat-pool overload

EOF
}

Internal_VLANConfig () {
  deviceName="$1"
  vlanInternalTemplateNames="$(printf '%s' "$VLANS_INTERNAL_TEMPLATE_NAMES" | sed 's/\\n/\n/g')"
  vlans=""
  vlanInterfaces=""
  vlanSVIIPAddress=""
  consolidatedOutput=""

  while IFS= read -r vlan_internal_template_name; do
    eval "$(cat <<EOF
vlanID="\${VLAN_${vlan_internal_template_name}_ID}"
vlanName="\${VLAN_${vlan_internal_template_name}_NAME}"
vlanSubnetMask="\${VLAN_${vlan_internal_template_name}_SUBNET_MASK}"
vlanDefaultGateway="\${VLAN_${vlan_internal_template_name}_DEFAULT_GATEWAY}"
vlanTrunkedBy="\${VLAN_${vlan_internal_template_name}_TRUNKED_BY}}"
sviIndex="\${${deviceName}_SVI_INDEX}"
EOF
    )"

    [ ! "$sviIndex" = "" ] &&
      eval "vlanSVIIPAddress=\"\${VLAN_${vlan_internal_template_name}_SVI${sviIndex}}\""

    # Configure only relevant VLANs that the switch will ever handle.
    # In Excel (comma-separated): VLANs[Trunked by]
    deviceTrunksVlan=
    while IFS= read -r trunkingDevice; do
      # Get exact matches
      if [ "$trunkingDevice" = "$deviceName" ] ||
           # Also match Excel entries w/o number suffix (e.g. `DSW` matches `DSW2`)
           [ ! "$(printf '%s' "$deviceName" | grep "^$trunkingDevice[[:digit:]]\{1,\}$")" ]; then
        deviceTrunksVlan=0
        break
      fi
    done <<EOF
$(printf '%s' "$vlanTrunkedBy" | sed 's/,/\n/g')
EOF

    [ ! "$deviceTrunksVlan" ] &&
      continue

    vlans="$vlans$(cat <<EOF

vlan $vlanID
  name $vlanName
EOF
    )"

    if [ ! "$vlanSVIIPAddress" = "" ]; then
        vlanInterfaces="$vlanInterfaces$(cat <<EOF


interface vlan $vlanID
  ip address $vlanSVIIPAddress $vlanSubnetMask
  standby version 2
  standby $vlanID ip $vlanDefaultGateway
  standby $vlanID priority 100
  no shutdown
EOF
      )"
    fi

  done <<EOF
$vlanInternalTemplateNames
EOF

  cat <<EOF
$vlans$vlanInterfaces

exit
EOF
}

CommonConfigDSW () {
  deviceName="$1"

  cat <<EOF
! === Inter-VLAN Routing ===
ip routing

$(Internal_VLANConfig "$deviceName")
EOF
}

CommonConfigASW_SSW () {
  deviceName="$1"
  cat <<'EOF'
! === VLANs ===
$(Internal_VLANConfig "$deviceName")
EOF
}

AccessportStanza () {
  vlanID="$1"
  cat <<EOF
 switchport access vlan $vlanID
 switchport mode access
 switchport nonegotiate
EOF
}

TrunkportStanza () {
  vlanIDsAllowed="$1"
  if [ ! "$vlanIDsAllowed" = "" ]; then
    cat <<EOF
 switchport trunk allowed vlan $vlanIDsAllowed
EOF
  fi
  cat <<EOF
; Removed this line as it's not recognised in the real Catalyst 9200.
; However, it's needed for Cisco CNL IOL L2 XE image.
; switchport trunk encapsulation dot1q
 switchport trunk native $VLAN_Native_ID
 switchport mode trunk
 switchport nonegotiate
EOF
}

ShutportStanza() {
  cat <<EOF
 switchport access vlan $VLAN_Park_ID
 switchport nonegotiate
 shutdown
EOF
}

-%>
