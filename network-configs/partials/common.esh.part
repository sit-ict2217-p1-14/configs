<%

Internal_CommonConfigAll_CISCO_IOS () {
  cat <<EOF
hostname $networkDeviceName

line console 0
 length 0



! === Remote Management ===

ip domain name $DOMAIN_SUFFIX_NET_MGMT
ip name-server $CachingDNSServer_IP_ADDRESS

crypto key generate rsa

vrf definition $OOB_VRF_NAME
 address-family ipv4
 exit-address-family
exit

interface $oobInterface
!  vrf command below is ignored if \$oobInterface is not "g0/0" (i.e.
!  its an OOB management switch). This is expected as OOB switches do
!  not need a separate VRF (cause why separate OOB from... OOB?).
 vrf forwarding $OOB_VRF_NAME
 ip address $oobIPAddress $VLAN_OOB_SUBNET_MASK
 no shutdown
exit



! === Logging ===

ntp server vrf $OOB_VRF_NAME $R1_OOB_IP_ADDRESS
archive
 log config
  logging enable
  notify syslog contenttype plaintext
 logging trap warnings
 logging source-interface $oobInterface vrf $OOB_VRF_NAME
 logging host $SIEM_OOB_IP_ADDRESS vrf $OOB_VRF_NAME transport udp port 9003


! === AAA ===

aaa new-model

username $ADMIN_USERNAME privilege 15 secret 0 $ADMIN_PASSWORD

line vty 0 $vtyMax
 logging synchronous
 transport input ssh
 exec-timeout 20 0
 login authentication default
exit

radius server RADVM
 address ipv4 $AAA_IP_ADDRESS auth-port 1812 acct-port 1813
 key $SECRET_RADIUS
 timeout 3
exit

aaa group server radius RADGRP
 server name RADVM
 !=== Previously missing VRF config for RADIUS
 ip vrf forwarding $OOB_VRF_NAME
 ip radius source-interface $oobInterface
exit

aaa authentication dot1x default group RADGRP
aaa authorization network default group RADGRP
aaa accounting dot1x default start-stop group RADGRP

tacacs server TACVM
 address ipv4 $AAA_IP_ADDRESS
 key $SECRET_TACACS
 timeout 2
exit

aaa group server tacacs+ TACGRP
 server name TACVM
 ip vrf forwarding $OOB_VRF_NAME
 ip tacacs source-interface $oobInterface
exit

aaa authentication login default group TACGRP local
aaa accounting exec default start-stop group TACGRP
aaa accounting commands 15 default stop-only group TACGRP
aaa authorization exec default group TACGRP local
aaa authorization commands 15 default group TACGRP local
aaa authorization console
EOF
}

Internal_CommonConfigAll_CISCO_ASA () {
  cat <<EOF
; === Remote Management ===
interface $oobInterface
 management-only
 nameif management
 security-level 100
 ip address $oobIPAddress $VLAN_OOB_SUBNET_MASK
exit

crypto key generate rsa modulus 2048
yes

ssh 0.0.0.0 0.0.0.0 management

ssh timeout 20
console timeout 20

; === AAA ===
; Test command: test aaa-server authentication TACGRP host $AAA_IP_ADDRESS username $SECRET_TACACS_ADMIN_USERNAME
aaa-server TACGRP protocol tacacs+
aaa-server TACGRP (management) host $AAA_IP_ADDRESS
 key $SECRET_TACACS
 timeout 2
exit

aaa authentication ssh console TACGRP LOCAL
aaa authentication serial console TACGRP LOCAL
aaa authentication enable console TACGRP LOCAL

aaa accounting ssh console TACGRP
aaa accounting serial console TACGRP
aaa accounting command privilege 15 TACGRP

aaa authorization exec authentication-server auto-enable
EOF
}


Internal_CommonConfigAll_PALOALTO_PANOS () {
  cat <<EOF
! === Remote Management ===
edit deviceconfig system
 set hostname $networkDeviceName
 set ip-address $oobIPAddress
 set netmask $VLAN_OOB_SUBNET_MASK
 set domain $DOMAIN_SUFFIX_NET_MGMT
 set domain-lookup-url $CachingDNSServer_IP_ADDRESS
top

; === AAA ===
; Test command: test authentication authentication-profile TAC-AUTH username $SECRET_TACACS_ADMIN_USERNAME password
edit shared server-profile tacplus TACVM
 set timeout 2
 set protocol PAP
 set server TACVM address $AAA_IP_ADDRESS secret $SECRET_TACACS port 49
 set admin-use-only yes
top

edit shared authentication-profile TAC-AUTH
 set method tacplus server-profile TACVM
 set allow-list all
top

edit deviceconfig system
 set authentication-profile TAC-AUTH
top
EOF
}

CommonConfigAll () {
  networkDeviceName="$1"
  OOB_VRF_NAME='Mgmt-vrf'
  eval "$(cat <<EOF
    syntax="\${${networkDeviceName}_SYNTAX}"
    vtyMax="\${${networkDeviceName}_VTY_COUNT}"
    oobIPAddress="\${${networkDeviceName}_OOB_IP_ADDRESS}"
    oobInterface="\${${networkDeviceName}_OOB_INTERFACE}"
EOF
  )"

  case "$syntax" in
    CISCO-IOS)
      Internal_CommonConfigAll_CISCO_IOS ;;
    CISCO-ASA)
      Internal_CommonConfigAll_CISCO_ASA ;;
    PA-PANOS)
      Internal_CommonConfigAll_PALOALTO_PANOS ;;
    *)
      echo "Error: '$syntax' is an unrecognised syntax type." >&2
  esac
}

CommonConfigR () {
  deviceName="$1"

  # Some janky hardcoding
  if [ "$deviceName" = "R1" ]; then
    routerIndex=1
  else
    routerIndex=2
  fi

  eval "$(cat <<EOF
    oobIPAddress="\$${deviceName}_OOB_IP_ADDRESS"
    ispRouterIP="\$ISP${routerIndex}_ROUTER_IP"
    ispDefaultGateway="\$ISP${routerIndex}_DEFAULT_GATEWAY"
    ispSubnetMask="\$ISP${routerIndex}_SUBNET_MASK"
    rxFW1VlanIPAddress="\$VLAN_R${routerIndex}_FW1_DEFAULT_GATEWAY"
    rxFW1VlanSubnetMask="\$VLAN_R${routerIndex}_FW1_SUBNET_MASK"
    rxFW1VlanSubnetAddress="\$VLAN_R${routerIndex}_FW1_SUBNET_ADDRESS"
    rxFW1VlanNetworkWildcard="\$VLAN_R${routerIndex}_FW1_NETWORK_WILDCARD"
EOF
  )"

  cat <<EOF
! === LAN-side: to FW1 ===
interface g0/0/0
 ip address $rxFW1VlanIPAddress $rxFW1VlanSubnetMask
 ip nat inside
 no shutdown

! === WAN-side: to ISP1 ===
interface g0/1/1
 ip address $ispRouterIP $ispSubnetMask
 ip nat outside
 no shutdown
exit

! === OSPF ===
router ospf 1
 router-id $oobIPAddress
 passive-interface default
 no passive-interface g0/0/0
 network $rxFW1VlanSubnetAddress $rxFW1VlanNetworkWildcard area 0
 default-information originate
exit

ip nat pool snat-pool 203.149.211.9 203.149.211.9 prefix-length 29

ip access-list standard snat-acl
 10 permit host $ispRouterIP
 20 permit $PRIVATE_NETWORK_SUBNET_ADDRESS $PRIVATE_NETWORK_NETWORK_WILDCARD

ip nat inside source list snat-acl pool snat-pool overload

ip route 0.0.0.0 0.0.0.0 $ispDefaultGateway
ip route $AuthoritativeDNSServer_ISP1_IP_ADDRESS_PUBLIC_FW1 255.255.255.255 $AuthoritativeDNSServer_ISP1_IP_ADDRESS
ip route $WebServer_ISP1_IP_ADDRESS_PUBLIC_FW1 255.255.255.255 $WebServer_ISP1_IP_ADDRESS
ip route $Jumphost_ISP1_IP_ADDRESS_PUBLIC_FW1 255.255.255.255 $Jumphost_ISP1_IP_ADDRESS
EOF
}

Internal_VLANConfig () {
  deviceName="$1"
  vlanInternalTemplateNames="$(printf '%s' "$VLANS_INTERNAL_TEMPLATE_NAMES" | sed 's/\\n/\n/g')"
  vlans=""
  vlanInterfaces=""
  vlanSVIIPAddress=""
  consolidatedOutput=""

  while IFS= read -r vlan_internal_template_name; do
    eval "$(cat <<EOF
vlanID="\${VLAN_${vlan_internal_template_name}_ID}"
vlanName="\${VLAN_${vlan_internal_template_name}_NAME}"
vlanSubnetMask="\${VLAN_${vlan_internal_template_name}_SUBNET_MASK}"
vlanDefaultGateway="\${VLAN_${vlan_internal_template_name}_DEFAULT_GATEWAY}"
vlanTrunkedBy="\${VLAN_${vlan_internal_template_name}_TRUNKED_BY}}"
vlanHasDHCPLease="\${VLAN_${vlan_internal_template_name}_DHCP_LEASE}"
sviIndex="\${${deviceName}_SVI_INDEX}"
EOF
    )"

    [ ! "$sviIndex" = "" ] &&
      eval "vlanSVIIPAddress=\"\${VLAN_${vlan_internal_template_name}_SVI${sviIndex}}\""

    # Configure only relevant VLANs that the switch will ever handle.
    # In Excel (comma-separated): VLANs[Trunked by]
    deviceTrunksVlan=
    while IFS= read -r trunkingDevice; do
      # Get exact matches
      if [ "$trunkingDevice" = "$deviceName" ] ||
           # Also match Excel entries w/o number suffix (e.g. `DSW` matches `DSW2`)
           [ ! "$(printf '%s' "$deviceName" | grep "^$trunkingDevice[[:digit:]]\{1,\}$")" ]; then
        deviceTrunksVlan=0
        break
      fi
    done <<EOF
$(printf '%s' "$vlanTrunkedBy" | sed 's/,/\n/g')
EOF

    [ ! "$deviceTrunksVlan" ] &&
      continue

    vlans="$vlans$(cat <<EOF

vlan $vlanID
  name $vlanName
EOF
    )"

    if [ "$sviIndex" = "1" ]; then
      rootPriority='primary'
    else
      rootPriority='secondary'
    fi

    if [ ! "$vlanSVIIPAddress" = "" ]; then
        vlanInterfaces="$vlanInterfaces$(cat <<EOF


interface vlan $vlanID
  ip address $vlanSVIIPAddress $vlanSubnetMask
  standby version 2
  standby $vlanID ip $vlanDefaultGateway
  standby $vlanID priority 100
  standby $vlanID preempt
  $([ "$vlanHasDHCPLease" = "0" ] && printf '%s' "ip helper-address $DHCP_IP_ADDRESS")
  no shutdown

spanning-tree vlan $vlanID root $rootPriority
EOF
      )"
    fi
  done <<EOF
$vlanInternalTemplateNames
EOF

  cat <<EOF
$vlans$vlanInterfaces

exit
EOF
}

CommonConfigDSW () {
  deviceName="$1"
  deviceNameToVLANName="$(printf '%s' "$deviceName" | sed -E 's/CSW/DSW/')"
  deviceIndex="$(printf '%s' "$deviceName" | sed -E 's/CSW//')"
  eval "$(cat <<EOF
ospfFW1Interface=\$VLAN_${deviceNameToVLANName}_FW1_ID
ospfFW2Interface=\$VLAN_${deviceNameToVLANName}_FW2_ID

vlanDswxFw1ID=\$VLAN_${deviceNameToVLANName}_FW1_ID
vlanDswxFw1FirstHost=\$VLAN_${deviceNameToVLANName}_FW1_FIRST_HOST
vlanDswxFw1SubnetMask=\$VLAN_${deviceNameToVLANName}_FW1_SUBNET_MASK


vlanDswxFw2ID=\$VLAN_${deviceNameToVLANName}_FW2_ID
vlanDswxFw2DefaultGateway=\$VLAN_${deviceNameToVLANName}_FW2_DEFAULT_GATEWAY
vlanDswxFw2FirstHost=\$VLAN_${deviceNameToVLANName}_FW2_FIRST_HOST
vlanDswxFw2SubnetMask=\$VLAN_${deviceNameToVLANName}_FW2_SUBNET_MASK
EOF
  )"

  if [ "$deviceIndex" -eq 1 ]; then
    vlanCoreSyncIPAddress="$VLAN_Core_Sync_FIRST_HOST"
  else
    vlanCoreSyncIPAddress="$VLAN_Core_Sync_SECOND_HOST"
  fi

  cat <<EOF
! === Inter-VLAN Routing ===
ip routing

interface vlan $VLAN_Core_Sync_ID
 ip address vlanCoreSyncIPAddress_HOST $VLAN_Core_Sync_SUBNET_MASK
 no shutdown

interface vlan $vlanDswxFw1ID
 ip address $vlanDswxFw1FirstHost $vlanDswxFw1SubnetMask
 no shutdown

interface vlan $vlanDswxFw2ID
 ip address $vlanDswxFw2DefaultGateway $vlanDswxFw2SubnetMask
 no shutdown

ip route $VLAN_IntSvc_SUBNET_ADDRESS $VLAN_IntSvc_SUBNET_MASK $vlanDswxFw2FirstHost


$(Internal_VLANConfig "$deviceName")



! === MACsec/MKA (DSW) ===
mka policy MKA-POL-DSW
 macsec-cipher-suite gcm-aes-xpn-256
 sak-rekey interval 3600
 send-secure-announcements

key chain MK-KC-DSW-PO1 macsec
 key 01
  cryptographic-algorithm aes-256-cmac
  key-string $SECRET_MACSEC_MKA_KC_DSW_PO1_PSK


! === OSPF ===
router ospf 1
 router-id $oobIPAddress
 passive-interface default
 no passive-interface vlan $VLAN_Core_Sync_ID
 no passive-interface vlan $ospfFW1Interface
 network $PRIVATE_NETWORK_SUBNET_ADDRESS $PRIVATE_NETWORK_NETWORK_WILDCARD area 0
 ! Required as FW2 does not participate in OSPF,
 ! and its subnets are static-routed:
 redistribute static



! === ACL ===
time-range TransactionsTimeRange
 periodic weekdays 08:00 to 17:00

ip access-list extended IntSvcOut
 permit tcp $Transactions_IP_ADDRESS $VLAN_IntSvc_NETWORK_WILDCARD any eq ftp time-range TransactionsTimeRange
 deny ip any any log



! === Interfaces ===
interface g1/0/1
$(TrunkportStanza "$VLAN_Staff_ID,$VLAN_ATM_ID,$VLAN_HR_ID,$VLAN_IT_ID")
 spanning-tree rootguard

interface range g1/0/21-22
 macsec network-link
 mka policy MKA-POL-DSW
 mka pre-shared-key key-chain MK-KC-DSW-PO1
 channel-group 1 mode active

interface port-channel 1
$(TrunkportStanza "$VLAN_Staff_ID,$VLAN_ATM_ID,$VLAN_HR_ID,$VLAN_IT_ID,$VLAN_Core_Sync_ID,$VLAN_DSW1_FW1_ID,$VLAN_DSW1_FW2_ID")

interface g1/0/23
$(AccessportStanza 105)
 spanning-tree rootguard
 ip access-group IntSvcOut out

interface g1/0/24
$(AccessportStanza 104)
 spanning-tree rootguard
EOF
}

CommonConfigASW_SSW () {
  deviceName="$1"
  cat <<EOF
! === VLANs ===
$(Internal_VLANConfig "$deviceName")
EOF
}

AccessportStanza () {
  vlanID="${1:-}"
  if [ ! "$vlanID" = "" ]; then
    cat <<EOF
 switchport access vlan $vlanID
EOF
  fi
  
  cat <<EOF
 switchport mode access
 switchport nonegotiate
EOF
}

# Global L2 defences + 802.1X for switches with end-user access ports.
# Usage: EndUserL2SecurityGlobal "<comma-separated end-user VLAN IDs>"
EndUserL2SecurityGlobal () {
  vlanIDs="$1"
  cat <<EOF
! === End-user L2 security (global) ===
spanning-tree mode rapid-pvst

ip dhcp snooping vlan $vlanIDs
no ip dhcp snooping information option
ip dhcp snooping
ip arp inspection vlan $vlanIDs

! 802.1X (EAP-TLS) against RADGRP; ports opt in via EndUserPortStanza
dot1x system-auth-control

errdisable recovery cause bpduguard
errdisable recovery cause psecure-violation
errdisable recovery cause dhcp-rate-limit
errdisable recovery cause arp-inspection

login on-failure log
login on-success log
EOF
}

# Access port for end-user hosts (Staff/ATM/HR/IT): AccessportStanza
# plus port-security, 802.1X, BPDU guard and DHCP snooping rate limit.
# The VLAN given here is the fallback; FreeRADIUS assigns the real VLAN
# per host certificate (Tunnel-Private-Group-Id in the users file).
# Usage: EndUserPortStanza <vlan-id>
EndUserPortStanza () {
  AccessportStanza "${1:-}"
  cat <<EOF
 switchport port-security maximum 3
 switchport port-security violation restrict
 switchport port-security aging time 5
 switchport port-security aging type inactivity
 switchport port-security
 authentication port-control auto
 authentication host-mode single-host
 authentication violation restrict
 dot1x pae authenticator
 dot1x timeout tx-period 10
 ! Against EAP flood attacks: 60 s quiet period after a failed attempt
 dot1x timeout held-period 60
 dot1x max-req 2
 spanning-tree portfast
 spanning-tree bpduguard enable
 ip dhcp snooping limit rate 15
EOF
}

# Uplink towards the distribution switches: trusted for DHCP snooping/DAI.
# Usage: append after TrunkportStanza on uplink trunks.
TrustedUplinkStanza () {
  cat <<EOF
 ip arp inspection trust
 ip dhcp snooping trust
EOF
}

TrunkportStanza () {
  vlanIDsAllowed="${1:-}"
  if [ ! "$vlanIDsAllowed" = "" ]; then
    cat <<EOF
 switchport trunk allowed vlan $vlanIDsAllowed
EOF
  fi
  cat <<EOF
; Removed this line as it's not recognised in the real Catalyst 9200.
; However, it's needed for Cisco CNL IOL L2 XE image.
; switchport trunk encapsulation dot1q
 switchport trunk native vlan $VLAN_Native_ID
 switchport mode trunk
 switchport nonegotiate
EOF
}

ShutportStanza() {
  cat <<EOF
 switchport access vlan $VLAN_Park_ID
 switchport nonegotiate
 shutdown
EOF
}

-%>
